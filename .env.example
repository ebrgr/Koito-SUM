KOITO_LOG_LEVEL=debug
KOITO_CONFIG_DIR=.local/koito
KOITO_BIND_ADDR=127.0.0.1
KOITO_LISTEN_PORT=4110
# Development credentials, used only when creating a new database.
KOITO_DEFAULT_USERNAME=admin
KOITO_DEFAULT_PASSWORD=changeme
# Keep local development independent of external music services/imports.
KOITO_DISABLE_MUSICBRAINZ=true
KOITO_DISABLE_DEEZER=true
KOITO_DISABLE_COVER_ART_ARCHIVE=true
KOITO_SKIP_IMPORT=true
TZ=Etc/UTC
