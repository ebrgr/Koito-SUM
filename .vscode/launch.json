{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Koito: Desenvolvimento (localhost:5173)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "CGO_ENABLED": "1" },
      "preLaunchTask": "Koito: frontend dev",
      "serverReadyAction": {
        "pattern": "Engine: Listening on 127\\.0\\.0\\.1:4110",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    },
    {
      "name": "Koito: API (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "CGO_ENABLED": "1" }
    },
    {
      "name": "Koito: Frontend (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "Koito: frontend dev"
    }
  ],
  "compounds": [
    {
      "name": "Koito: API + Frontend",
      "configurations": ["Koito: API (Go)", "Koito: Frontend (Chrome)"],
      "stopAll": true
    }
  ]
}
